# Copy to .env and fill in. Never commit .env.

# ---------- LLM ----------
# openai_compat = any OpenAI-compatible API (Groq, Ollama, OpenRouter, Gemini's compat endpoint)
# anthropic     = Claude via the Anthropic SDK
# fake          = no LLM (only for tests / dry runs)
LLM_PROVIDER=openai_compat
# Pick a model that supports tool calling from your provider's model list.
LLM_MODEL=
# Groq:   https://api.groq.com/openai/v1
# Ollama: http://localhost:11434/v1   (LLM_API_KEY can be any text)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Optional: price per 1M tokens so the dashboard can show cost (0 = free tier)
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0

# Example for Claude instead:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=sk-ant-...

# ---------- Agent limits ----------
MAX_ATTEMPTS=3
MAX_STEPS_PER_ATTEMPT=15

# ---------- Sandbox ----------
# docker = isolated container (use this). local = plain subprocess, NOT isolated (dev only)
SANDBOX_BACKEND=docker
SANDBOX_IMAGE=redtogreen-sandbox:latest
SANDBOX_TIMEOUT_S=120

# ---------- GitHub (Level 2+) ----------
# Fine-grained token for your demo repo: Contents RW, Pull requests RW, Actions read, Issues RW
GITHUB_TOKEN=
# docker (runs ghcr.io/github/github-mcp-server), binary, or remote (api.githubcopilot.com)
GITHUB_MCP_MODE=docker
# Only these repos are handled (comma separated). Empty = all repos that send a valid webhook.
ALLOWED_REPOS=

# ---------- Server (Level 3) ----------
GITHUB_WEBHOOK_SECRET=change-me
ADMIN_TOKEN=change-me-too
PUBLIC_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://redtogreen:redtogreen@localhost:5432/redtogreen
REDIS_URL=redis://localhost:6379/0
